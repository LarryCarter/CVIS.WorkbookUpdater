<Window x:Class="CVIS.WorkbookUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CVIS Workbook Updater" Height="820" Width="1180"
        MinHeight="680" MinWidth="920">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="CVIS Workbook Updater" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Preview, stage, and safely apply mapped updates. Synced OneDrive paths are supported; close desktop Excel before saving." Foreground="#555"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Workbook" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="WorkbookPathTextBox" Margin="8,0"/>
            <Button Grid.Column="2" Content="Browse..." Click="BrowseWorkbook_Click"/>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Manual Update">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Submitted By" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="SubmittedByTextBox" Margin="0,0,16,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Update Type" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" x:Name="UpdateTypeComboBox" Margin="0,0,0,8">
                        <ComboBoxItem Content="Manual Update" IsSelected="True"/>
                        <ComboBoxItem Content="Owner Update"/>
                        <ComboBoxItem Content="RYG / Risk Update"/>
                        <ComboBoxItem Content="Date Update"/>
                        <ComboBoxItem Content="Dependency Update"/>
                        <ComboBoxItem Content="Application Inventory Update"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Table" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetTableComboBox" Margin="0,0,16,8">
                        <ComboBoxItem Content="Application Inventory" IsSelected="True"/>
                        <ComboBoxItem Content="At-Risk Register"/>
                        <ComboBoxItem Content="Dependencies"/>
                        <ComboBoxItem Content="Milestones"/>
                        <ComboBoxItem Content="Action Plan"/>
                        <ComboBoxItem Content="Platform Onboarding"/>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Effective Date" Margin="0,0,8,8"/>
                    <DatePicker Grid.Row="1" Grid.Column="3" x:Name="EffectiveDatePicker" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Record Key Field" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RecordKeyFieldTextBox" Text="Application / Component" Margin="0,0,16,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Record Key Value" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="RecordKeyValueTextBox" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Field To Update" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="FieldToUpdateTextBox" Margin="0,0,16,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="New Value" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="NewValueTextBox" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NotesTextBox"
                             Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="DryRunCheckBox" Content="Preview only; do not save workbook" Margin="0,0,16,8"/>
                    <StackPanel Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Stage for Review" Width="150" Margin="0,0,8,0" Click="AppendManualUpdate_Click"/>
                        <Button Content="Apply Now" Width="130" Click="ApplyManualUpdate_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Bulk Import">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Import File" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ImportPathTextBox" Margin="0,0,8,8"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseImport_Click" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mapping Profile" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MappingProfileTextBox" Text="ApplicationOwnerIntake" Margin="0,0,8,8"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Load Mappings" Click="LoadMappings_Click" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MappingSummaryTextBlock" Foreground="#555" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ImportPreviewGrid"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Target" Binding="{Binding Update.TargetTable}" Width="150"/>
                            <DataGridTextColumn Header="Record" Binding="{Binding Update.RecordKeyValue}" Width="120"/>
                            <DataGridTextColumn Header="Field" Binding="{Binding Update.FieldToUpdate}" Width="150"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="150"/>
                            <DataGridTextColumn Header="Proposed" Binding="{Binding Update.NewValue}" Width="150"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Preview Import" Width="130" Click="PreviewImport_Click" Margin="0,0,8,0"/>
                        <Button Content="Stage for Review" Width="140" Click="ImportUpdates_Click" Margin="0,0,8,0"/>
                        <Button Content="Apply Ready Updates" Width="160" Click="ApplyImportUpdates_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Blocker / Risk">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Risk / Item" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RiskItemTextBox" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RYG Status" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RiskStatusComboBox" Margin="0,0,16,8">
                        <ComboBoxItem Content="Red"/><ComboBoxItem Content="Yellow" IsSelected="True"/><ComboBoxItem Content="Green"/>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Next Action Date" Margin="0,0,8,8"/>
                    <DatePicker Grid.Row="1" Grid.Column="3" x:Name="RiskNextDatePicker" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reason / Blocker" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RiskReasonTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Recovery Action" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RiskActionTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Leadership Ask" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RiskLeadershipAskTextBox" Margin="0,0,0,8"/>
                    <Button Grid.Row="7" Grid.Column="3" Content="Preview and Apply Risk Update" Width="210" HorizontalAlignment="Right" Click="ApplyRiskUpdate_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Ticket / Work">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Sheet" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="WorkTargetComboBox" Margin="0,0,16,8" IsEditable="True">
                        <ComboBoxItem Content="Action Plan" IsSelected="True"/><ComboBoxItem Content="Delivery Tasks"/>
                        <ComboBoxItem Content="Dev Tasks"/><ComboBoxItem Content="NFRs"/><ComboBoxItem Content="Platform Onboarding"/>
                    </ComboBox>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Key Field" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="WorkKeyFieldTextBox" Text="ID" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ticket / Work ID" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="WorkIdTextBox" Margin="0,0,16,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Status Field" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="WorkStatusFieldTextBox" Text="Status" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Margin="0,0,8,8"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="WorkStatusComboBox" Margin="0,0,16,8" IsEditable="True">
                        <ComboBoxItem Content="Not Started"/><ComboBoxItem Content="In Progress" IsSelected="True"/>
                        <ComboBoxItem Content="At Risk"/><ComboBoxItem Content="Blocked"/><ComboBoxItem Content="Waiting External"/><ComboBoxItem Content="Complete"/>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Next Action Field" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="WorkNextActionFieldTextBox" Text="Next Action" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Next Action" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="WorkNextActionTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Explanation / Notes" Margin="0,0,8,8"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="WorkNotesTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
                    <Button Grid.Row="6" Grid.Column="3" Content="Preview and Apply Work Update" Width="210" HorizontalAlignment="Right" Click="ApplyWorkUpdate_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBox Grid.Row="3" x:Name="LogTextBox" Margin="0,12,0,0" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
    </Grid>
</Window>
